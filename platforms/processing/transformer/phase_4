-- models/gold/mart_stock_kpi_daily.sql
MODEL (
  name gold.mart_stock_kpi_daily,
  kind INCREMENTAL_BY_TIME (
    time_column trade_date
  ),
  cron '@daily',
  owner 'data_team',
  description 'Bảng Data Mart tổng hợp các chỉ số KPI kỹ thuật hàng ngày cho cổ phiếu'
);

WITH daily_metrics AS (
  SELECT 
    symbol,
    ingest_date AS trade_date,
    close_price,
    volume,
    foreign_buy,
    -- Tính giá trị giao dịch (Turnover)
    (close_price * volume) AS turnover,
    
    -- Lấy giá đóng cửa của ngày hôm trước (Subsystem 20: Aggregate/Window)
    LAG(close_price) OVER (
      PARTITION BY symbol ORDER BY ingest_date
    ) AS prev_close_price
    
  FROM silver.stock_prices_clean
),

calculated_kpis AS (
  SELECT
    *,
    -- Tính tỷ suất sinh lời (%) so với ngày hôm trước
    CASE 
      WHEN prev_close_price > 0 THEN ((close_price - prev_close_price) / prev_close_price) * 100 
      ELSE 0 
    END AS daily_return_pct,

    -- Tính Moving Average 5 ngày (MA5)
    AVG(close_price) OVER (
      PARTITION BY symbol ORDER BY trade_date ROWS BETWEEN 4 PRECEDING AND CURRENT ROW
    ) AS ma5_price,

    -- Tính Moving Average 20 ngày (MA20)
    AVG(close_price) OVER (
      PARTITION BY symbol ORDER BY trade_date ROWS BETWEEN 19 PRECEDING AND CURRENT ROW
    ) AS ma20_price
    
  FROM daily_metrics
)

SELECT
  symbol,
  trade_date,
  close_price,
  volume,
  turnover,
  daily_return_pct,
  ma5_price,
  ma20_price,
  -- Xếp hạng theo giá trị giao dịch trong ngày (Turnover Rank)
  RANK() OVER (
    PARTITION BY trade_date ORDER BY turnover DESC
  ) AS turnover_rank_in_market
FROM calculated_kpis
WHERE trade_date = @ds; -- SQLMesh Macro: Chỉ chạy cho ngày hiện tại