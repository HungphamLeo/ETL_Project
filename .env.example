# ====================================
# MinIO / S3 Data Lake Configuration
# ====================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secure_123
S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin_secure_123

# ====================================
# PostgreSQL Data Warehouse Configuration
# ====================================
POSTGRES_USER=dw_admin
POSTGRES_PASSWORD=postgres_secure_123
POSTGRES_DB=stock_financial_dw
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ====================================
# Prefect Orchestration Configuration
# ====================================
PREFECT_API_URL=http://localhost:4200/api
PREFECT_HOME=/root/.prefect
PREFECT_LOGGING_LEVEL=INFO

# ====================================
# Kafka Configuration (Event Streaming)
# ====================================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SECURITY_PROTOCOL=PLAINTEXT

# ====================================
# Data Lake Paths
# ====================================
LAKEHOUSE_BUCKET=lakehouse
BRONZE_PATH=s3://lakehouse/bronze
SILVER_PATH=s3://lakehouse/silver
GOLD_PATH=s3://lakehouse/gold

# ====================================
# ETL Project Configuration
# ====================================
PROJECT_NAME=stock_financial_etl
PROJECT_VERSION=0.2.0
ENVIRONMENT=development

# ====================================
# Logging Configuration
# ====================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_RETENTION_DAYS=14

# ====================================
# API Configuration
# ====================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# ====================================
# Web Scraping Configuration
# ====================================
HTTP_TIMEOUT_SECONDS=30
HTTP_DELAY_SECONDS=0.3
HTTP_RETRIES=3

# ====================================
# Monitoring Configuration
# ====================================
PROMETHEUS_ENABLED=true
GRAFANA_ENABLED=true
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ====================================
# Security Configuration
# ====================================
ENCRYPTION_KEY_PATH=./internal/config/encryption.key
SECRETS_BACKEND=env
ROTATE_SECRETS_DAYS=30

# ====================================
# Performance Configuration
# ====================================
SPARK_MEMORY=4g
SQLMESH_THREADS=4
DUCKDB_MAX_MEMORY=8gb

